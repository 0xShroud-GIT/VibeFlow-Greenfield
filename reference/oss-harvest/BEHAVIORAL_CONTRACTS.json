{"schema_version":"1.0","behavioral_contract_tests":[{"test_id":"T-001","contract":"Stale/late agent or provider results cannot mutate the current Execution.","routes":["DURABLE_EXECUTION","RECOVERY"],"owning_missions":["M-024","M-025","M-026","M-027","M-028","M-077","M-078","M-079","M-080","M-081"],"representative_references":["REF-006","REF-011","REF-012"]},{"test_id":"T-002","contract":"Duplicate durable commands/results are idempotent; conflicting duplicates fail closed.","routes":["DURABLE_EXECUTION"],"owning_missions":["M-024","M-025","M-026","M-027","M-028"],"representative_references":["REF-006","REF-004"]},{"test_id":"T-003","contract":"Reconnect reattaches/observes; it never silently restarts an external execution.","routes":["REMOTE_LAYER","RECOVERY"],"owning_missions":["M-029","M-030","M-031","M-032","M-077","M-078","M-079","M-080","M-081"],"representative_references":["REF-001","REF-006","REF-008","REF-009"]},{"test_id":"T-004","contract":"Observation loss may produce UNKNOWN/RECONCILING/LOST; it must not invent success.","routes":["RECOVERY","REMOTE_LAYER"],"owning_missions":["M-077","M-078","M-079","M-080","M-081","M-029","M-030","M-031","M-032"],"representative_references":["REF-006","REF-004"]},{"test_id":"T-005","contract":"Partial streamed tool/progress output is not the authoritative final ToolResult.","routes":["DURABLE_EXECUTION","MCP_TOOLS"],"owning_missions":["M-024","M-025","M-026","M-027","M-028","M-082","M-083","M-084","M-085","M-086"],"representative_references":["REF-006","REF-011"]},{"test_id":"T-006","contract":"Provider-hosted tool activity is not permission for a VibeFlow-local tool invocation.","routes":["MODEL_INTEGRATION","MCP_TOOLS","CONNECTIONS_GRANTS"],"owning_missions":["M-043","M-044","M-045","M-046","M-082","M-083","M-084","M-085","M-086","M-020","M-021","M-022","M-023"],"representative_references":["REF-006"]},{"test_id":"T-007","contract":"Tool discovery/capability availability never creates a Grant.","routes":["MCP_TOOLS"