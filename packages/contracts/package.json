{
  "name": "@vibeflow/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VibeFlow contracts foundation — JSON Schema first with TypeBox 1.x",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "typebox": "1.3.6"
  }
}
